# FFMPEG is only the build of gpu/ffmpeg.txt that tools/build-ffmpeg.sh installed in DCP_FFMPEG_PREFIX.
set(DCP_FFMPEG_PREFIX "" CACHE PATH "Prefix of the FFmpeg built by tools/build-ffmpeg.sh")
if (NOT DCP_FFMPEG_PREFIX)
    message(FATAL_ERROR "DCP_FFMPEG_PREFIX is not set: build with tools/build.ps1 or tools/build.sh, which build FFmpeg")
endif()

set(ffmpeg_pin "${CMAKE_CURRENT_LIST_DIR}/../ffmpeg.txt")
set(ffmpeg_script "${CMAKE_CURRENT_LIST_DIR}/../../tools/build-ffmpeg.sh")
set(ffmpeg_stamp "${DCP_FFMPEG_PREFIX}/share/licenses/ffmpeg/dcp-build.stamp")
if (NOT EXISTS "${ffmpeg_stamp}")
    message(FATAL_ERROR "${DCP_FFMPEG_PREFIX} holds no FFmpeg built by tools/build-ffmpeg.sh")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${ffmpeg_pin}" "${ffmpeg_script}" "${ffmpeg_stamp}")
file(SHA256 "${ffmpeg_pin}" ffmpeg_pin_sha256)
file(SHA256 "${ffmpeg_script}" ffmpeg_script_sha256)
file(READ "${ffmpeg_stamp}" ffmpeg_built)
if (NOT ffmpeg_built STREQUAL "${ffmpeg_pin_sha256}-${ffmpeg_script_sha256}")
    message(FATAL_ERROR "The FFmpeg in ${DCP_FFMPEG_PREFIX} is not the one of gpu/ffmpeg.txt and tools/build-ffmpeg.sh: rebuild it")
endif()

# pkg_check_modules keeps the libraries of an earlier configuration otherwise.
get_cmake_property(ffmpeg_cached CACHE_VARIABLES)
list(FILTER ffmpeg_cached INCLUDE REGEX "^(__pkg_config_checked_FFMPEG|pkgcfg_lib_FFMPEG_.*|FFMPEG_.*)$")
foreach (variable IN LISTS ffmpeg_cached)
    unset(${variable} CACHE)
endforeach()
# An inherited PKG_CONFIG_PATH is searched before CMAKE_PREFIX_PATH.
set(ffmpeg_inherited "$ENV{PKG_CONFIG_PATH}")
set(ENV{PKG_CONFIG_PATH} "${DCP_FFMPEG_PREFIX}/lib/pkgconfig")
list(PREPEND CMAKE_PREFIX_PATH "${DCP_FFMPEG_PREFIX}")
pkg_check_modules(FFMPEG REQUIRED IMPORTED_TARGET libavformat>=59.27 libavcodec>=59.37 libavutil>=57.28 libswscale>=6.7
    libswresample>=4.7)
set(ENV{PKG_CONFIG_PATH} "${ffmpeg_inherited}")

set(ffmpeg_root "${DCP_FFMPEG_PREFIX}")
if (WIN32)
    string(TOLOWER "${ffmpeg_root}" ffmpeg_root)
endif()
foreach (path IN LISTS FFMPEG_LINK_LIBRARIES FFMPEG_LIBRARY_DIRS FFMPEG_INCLUDE_DIRS)
    set(ffmpeg_path "${path}")
    if (WIN32)
        string(TOLOWER "${ffmpeg_path}" ffmpeg_path)
    endif()
    cmake_path(IS_PREFIX ffmpeg_root "${ffmpeg_path}" NORMALIZE from_prefix)
    if (NOT from_prefix)
        message(FATAL_ERROR "FFmpeg was found in ${path}, not in DCP_FFMPEG_PREFIX ${DCP_FFMPEG_PREFIX}")
    endif()
endforeach()
list(LENGTH FFMPEG_LINK_LIBRARIES ffmpeg_count)
if (ffmpeg_count LESS 5)
    message(FATAL_ERROR "FFmpeg libraries are missing from ${DCP_FFMPEG_PREFIX}: found only ${FFMPEG_LINK_LIBRARIES}")
endif()
message(STATUS "Pinned FFmpeg: ${FFMPEG_LINK_LIBRARIES}")
