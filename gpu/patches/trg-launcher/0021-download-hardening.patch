+// Removes "." and ".." segments of the path; the query stays as it is.
+std::string RemoveDotSegments(const std::string& target) {
+  const size_t query = target.find('?');
+  const std::string path = target.substr(0, query);
+  const std::string tail = query == std::string::npos ? std::string() : target.substr(query);
+  std::vector<std::string> kept;
+  size_t at = 0;
+  while (at <= path.size()) {
+    size_t slash = path.find('/', at);
+    if (slash == std::string::npos) {
+      slash = path.size();
+    }
+    const std::string segment = path.substr(at, slash - at);
+    if (segment == "..") {
+      if (kept.size() > 1) {
+        kept.pop_back();
+      }
+    } else if (segment != ".") {
+      kept.push_back(segment);
+    }
+    at = slash + 1;
+  }
+  std::string result;
+  for (size_t i = 0; i < kept.size(); ++i) {
+    result += (i == 0 ? "" : "/") + kept[i];
+  }
+  const std::string last = path.substr(path.rfind('/') + 1);
+  if ((last == "." || last == "..") && (result.empty() || result.back() != '/')) {
+    result += '/';
+  }
+  if (result.empty()) {
+    result = "/";
+  }
+  return result + tail;
+}
+
+// RFC 3986 scheme: a letter, then letters, digits, "+", "-" or "." up to the first colon.
+bool HasScheme(const std::string& location) {
+  if (location.empty() || !std::isalpha(static_cast<unsigned char>(location[0]))) {
+    return false;
+  }
+  for (const char c : location) {
+    if (c == ':') {
+      return true;
+    }
+    if (!std::isalnum(static_cast<unsigned char>(c)) && c != '+' && c != '-' && c != '.') {
+      return false;
+    }
+  }
+  return false;
+}
