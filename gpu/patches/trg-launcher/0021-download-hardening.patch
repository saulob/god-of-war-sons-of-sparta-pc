+// Digits only and short enough that the value cannot overflow; anything else is not a length.
+[[maybe_unused]] bool ParseDecimal(const std::string& text, long long& value) {
+  const size_t first = text.find_first_not_of(" \t");
+  const size_t last = text.find_last_not_of(" \t");
+  if (first == std::string::npos) {
+    return false;
+  }
+  const std::string digits = text.substr(first, last - first + 1);
+  if (digits.size() > 15) {
+    return false;
+  }
+  value = 0;
+  for (const char c : digits) {
+    if (c < '0' || c > '9') {
+      return false;
+    }
+    value = value * 10 + (c - '0');
+  }
+  return true;
+}
