+const char* HttpFailureName(HttpFailure failure) {
+  switch (failure) {
+    case HttpFailure::kNone: return "none";
+    case HttpFailure::kCancelled: return "cancelled";
+    case HttpFailure::kConnectTimeout: return "connect_timeout";
+    case HttpFailure::kReceiveTimeout: return "receive_timeout";
+    case HttpFailure::kTotalTimeout: return "total_timeout";
+    case HttpFailure::kHttpStatus: return "http_status";
+    case HttpFailure::kRedirectLimit: return "redirect_limit";
+    case HttpFailure::kHttpsDowngrade: return "https_downgrade";
+    case HttpFailure::kInvalidRedirect: return "invalid_redirect";
+    case HttpFailure::kAddressNotAllowed: return "address_not_allowed";
+    case HttpFailure::kSizeLimit: return "size_limit";
+    case HttpFailure::kContentLength: return "content_length";
+    case HttpFailure::kInterrupted: return "interrupted";
+    case HttpFailure::kFilesystem: return "filesystem";
+    case HttpFailure::kNetwork: return "network";
+    case HttpFailure::kInvalidRequest: return "invalid_request";
+  }
+  return "network";
+}
+
+HttpFailure ResolveRedirect(const std::string& from_url, const std::string& location, std::string& target) {
+  target.clear();
+  ParsedUrl from;
+  ParsedUrl next;
+  if (location.empty() || !ParseUrl(from_url, from) || !ParseUrl(ResolveLocation(from, location), next)) {
+    return HttpFailure::kInvalidRedirect;
+  }
+  if (from.Secure() && !next.Secure()) {
+    return HttpFailure::kHttpsDowngrade;
+  }
+  target = next.Origin() + next.target;
+  return HttpFailure::kNone;
+}
+
+bool SameOrigin(const std::string& first_url, const std::string& second_url) {
+  ParsedUrl first;
+  ParsedUrl second;
+  return ParseUrl(first_url, first) && ParseUrl(second_url, second) && first.SameOrigin(second);
+}
+
+bool IsSensitiveHeader(const std::string& name) {
+  std::string lower = Lower(name);
+  for (const char* part : {"authorization", "cookie", "token", "secret", "password", "api-key", "apikey", "auth"}) {
+    if (lower.find(part) != std::string::npos) {
+      return true;
+    }
+  }
+  return false;
+}
