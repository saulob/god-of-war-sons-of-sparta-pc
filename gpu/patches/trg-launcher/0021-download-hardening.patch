+constexpr long long kMaxRetryAfterMs = 24ll * 60 * 60 * 1000;
+
+[[maybe_unused]] long long RetryAfterMs(const std::string& text) {
+  long long seconds = 0;
+  if (!ParseDecimal(text, seconds)) {
+    return -1;
+  }
+  return std::min<long long>(seconds * 1000, kMaxRetryAfterMs);
+}
