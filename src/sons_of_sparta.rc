#include <winuser.h>
#include <winver.h>
#include "sos_version.h"

1 ICON "../packaging/icons/app-icon.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "sons_of_sparta.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION SOS_VERSION_NUMBERS
PRODUCTVERSION SOS_VERSION_NUMBERS
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "saulob"
            VALUE "FileDescription", "God of War: Sons of Sparta PC"
            VALUE "FileVersion", SOS_FILE_VERSION_STRING
            VALUE "InternalName", "sons_of_sparta"
            VALUE "OriginalFilename", "sons_of_sparta.exe"
            VALUE "ProductName", "God of War: Sons of Sparta PC"
            VALUE "ProductVersion", SOS_VERSION_STRING
            VALUE "Comments", "https://github.com/saulob/god-of-war-sons-of-sparta-pc"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
